{
  "schemaVersion": 2,
  "recorder": {
    "capture": { "kind": "display" },
    "captureBackend": "dda",
    "fps": 60,
    "fps": 30,
    "cursorMode": "software",
    "maxDurationSeconds": 30,
    "inputControl": { "enabled": false }
  },
  "steps": [
    { "type": "wait", "durationMs": 1200 },
    { "type": "mark", "id": "reveal", "intensity": 0.7 },
    { "type": "wait", "durationMs": 1200 }
  ],
  "render": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "captions": [
      {
        "text": "Gravação controlada por roteiro",
        "startSeconds": 0.2,
        "endSeconds": 2.1,
        "anchor": "auto",
        "fontSize": 44,
        "color": "#FFFFFFFF",
        "backgroundColor": "#000000AD",
        "transition": { "in": "fade", "out": "fade", "durationSeconds": 0.25 }
      }
    ],
    "camera": [
      { "atSeconds": 0, "target": { "kind": "desktop" }, "transition": "instant" }
    ]
  }
}
